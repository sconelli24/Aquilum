}

[data-theme="paper-washi"] {
    color-scheme: light;
    --q-theme-name: 'Papel washi';
    --q-pp-rosewater: #b8776b;
    --q-pp-flamingo: #bb7680;
    --q-pp-pink: #ad6a93;
    --q-pp-mauve: #7d62a3;
    --q-pp-red: #b5403a;
    --q-pp-maroon: #b85a52;
    --q-pp-peach: #c0692e;
    --q-pp-yellow: #a98a2a;
    --q-pp-green: #4f8a46;
    --q-pp-teal: #2e8a7c;
    --q-pp-sky: #3d8fae;
    --q-pp-sapphire: #3a8299;
    --q-pp-blue: #3b6aa3;
    --q-pp-lavender: #5c72b8;
    --q-pp-text: #2b3a33;
    --q-pp-subtext1: #3d4d45;
    --q-pp-subtext0: #56665d;
    --q-pp-overlay2: #6b7b72;
    --q-pp-overlay1: #8a9890;
    --q-pp-overlay0: #a2aea7;
    --q-pp-surface2: #c8cdc2;
    --q-pp-surface1: #d6dace;
    --q-pp-surface0: #e3e6da;
    --q-pp-base: #f4f4ec;
    --q-pp-mantle: #eaebe0;
    --q-pp-crust: #dde0d1;
    --q-pp-accent: #26796c;
    --q-calendar-bg: #fbfbf7;
    --q-calendar-accent: var(--q-pp-teal);
}

[data-theme="paper-pastel"] {
    color-scheme: light;
    --q-theme-name: 'Pastel calido';
    --q-pp-rosewater: #d98b76;
    --q-pp-flamingo: #e0827f;
    --q-pp-pink: #d9688f;
    --q-pp-mauve: #a86bb8;
    --q-pp-red: #d4503f;
    --q-pp-maroon: #d9655a;
    --q-pp-peach: #e8843a;
    --q-pp-yellow: #cf9a1e;
    --q-pp-green: #7ba24a;
    --q-pp-teal: #4a9d8a;
    --q-pp-sky: #5aa7c4;
    --q-pp-sapphire: #4a97b3;
    --q-pp-blue: #5b82c4;
    --q-pp-lavender: #8d86c9;
    --q-pp-text: #5a4032;
    --q-pp-subtext1: #6d5242;
    --q-pp-subtext0: #84685a;
    --q-pp-overlay2: #9a8071;
    --q-pp-overlay1: #ae9686;
    --q-pp-overlay0: #c2ad9e;
    --q-pp-surface2: #e8d3bf;
    --q-pp-surface1: #f0decd;
    --q-pp-surface0: #f6e8da;
    --q-pp-base: #fff8ef;
    --q-pp-mantle: #fdeedd;
    --q-pp-crust: #f8e0c9;
    --q-pp-accent: #c9561f;
    --q-calendar-bg: #fffdf8;
    --q-calendar-accent: var(--q-pp-peach);
}

[data-theme="paper-chalkboard"] {
    color-scheme: dark;
    --q-theme-name: 'Pizarra';
    --q-pp-rosewater: #f0d4c7;
    --q-pp-flamingo: #eec2bd;
    --q-pp-pink: #eebad8;
    --q-pp-mauve: #cdb0ea;
    --q-pp-red: #f09a96;
    --q-pp-maroon: #eba9a0;
    --q-pp-peach: #f2b488;
    --q-pp-yellow: #efd98a;
    --q-pp-green: #b3de96;
    --q-pp-teal: #8fd9c4;
    --q-pp-sky: #9bd7e3;
    --q-pp-sapphire: #86c3dc;
    --q-pp-blue: #94b8ee;
    --q-pp-lavender: #b9bff0;
    --q-pp-text: #e9e8da;
    --q-pp-subtext1: #d8d8c8;
    --q-pp-subtext0: #c2c4b2;
    --q-pp-overlay2: #a9ac9b;
    --q-pp-overlay1: #8f9384;
    --q-pp-overlay0: #767b6f;
    --q-pp-surface2: #5e6a62;
    --q-pp-surface1: #4c5a53;
    --q-pp-surface0: #3c4b45;
    --q-pp-base: #2d3b36;
    --q-pp-mantle: #25312d;
    --q-pp-crust: #1d2723;
    --q-pp-accent: #efd98a;
    --q-calendar-bg: #33453f;
    --q-calendar-accent: var(--q-pp-yellow);
}

[data-theme="paper-moleskine"] {
    color-scheme: dark;
    --q-theme-name: 'Moleskine';
    --q-pp-rosewater: #f1d3c4;
    --q-pp-flamingo: #edbab6;
    --q-pp-pink: #eab4d2;
    --q-pp-mauve: #c6a7e8;
    --q-pp-red: #ee9490;
    --q-pp-maroon: #e8a39a;
    --q-pp-peach: #f0aa78;
    --q-pp-yellow: #e6c06a;
    --q-pp-green: #aedc8e;
    --q-pp-teal: #86d4be;
    --q-pp-sky: #94d0e0;
    --q-pp-sapphire: #80bad8;
    --q-pp-blue: #8db0ea;
    --q-pp-lavender: #b1b8ee;
    --q-pp-text: #ece4d2;
    --q-pp-subtext1: #dbd3c1;
    --q-pp-subtext0: #c4bca9;
    --q-pp-overlay2: #aca48f;
    --q-pp-overlay1: #938b78;
    --q-pp-overlay0: #7a7260;
    --q-pp-surface2: #615a4b;
    --q-pp-surface1: #4f493c;
    --q-pp-surface0: #3f3a30;
    --q-pp-base: #2a2724;
    --q-pp-mantle: #211f1c;
    --q-pp-crust: #171513;
    --q-pp-accent: #e6c06a;
    --q-calendar-bg: #2a2724;
    --q-calendar-accent: var(--q-pp-yellow);
}

[data-theme="paper-notebook"],
[data-theme="paper-legal"],
[data-theme="paper-kraft"],
[data-theme="paper-washi"],
[data-theme="paper-pastel"] {
    /* Un color por tono: toda la escala toma el mismo. */
    --q-red-alpha-main: var(--q-pp-red);
    --q-red-50: var(--q-pp-red);
    --q-red-100: var(--q-pp-red);
    --q-red-200: var(--q-pp-red);
    --q-red-300: var(--q-pp-red);
    --q-red-400: var(--q-pp-red);
    --q-red-500: var(--q-pp-red);
    --q-red-600: var(--q-pp-red);
    --q-red-700: var(--q-pp-red);
    --q-red-800: var(--q-pp-red);
    --q-red-900: var(--q-pp-red);
    --q-red-950: var(--q-pp-red);
    --q-amber-alpha-main: var(--q-pp-peach);
    --q-amber-50: var(--q-pp-peach);
    --q-amber-100: var(--q-pp-peach);
    --q-amber-200: var(--q-pp-peach);
    --q-amber-300: var(--q-pp-peach);
    --q-amber-400: var(--q-pp-peach);
    --q-amber-500: var(--q-pp-peach);
    --q-amber-600: var(--q-pp-peach);
    --q-amber-700: var(--q-pp-peach);
    --q-amber-800: var(--q-pp-peach);
    --q-amber-900: var(--q-pp-peach);
    --q-amber-950: var(--q-pp-peach);
    --q-green-alpha-main: var(--q-pp-green);
    --q-green-50: var(--q-pp-green);
    --q-green-100: var(--q-pp-green);
    --q-green-200: var(--q-pp-green);
    --q-green-300: var(--q-pp-green);
    --q-green-400: var(--q-pp-green);
    --q-green-500: var(--q-pp-green);
    --q-green-600: var(--q-pp-green);
    --q-green-700: var(--q-pp-green);
    --q-green-800: var(--q-pp-green);
    --q-green-900: var(--q-pp-green);
    --q-green-950: var(--q-pp-green);
    --q-teal-alpha-main: var(--q-pp-teal);
    --q-teal-50: var(--q-pp-teal);
    --q-teal-100: var(--q-pp-teal);
    --q-teal-200: var(--q-pp-teal);
    --q-teal-300: var(--q-pp-teal);
    --q-teal-400: var(--q-pp-teal);
    --q-teal-500: var(--q-pp-teal);
    --q-teal-600: var(--q-pp-teal);
    --q-teal-700: var(--q-pp-teal);
    --q-teal-800: var(--q-pp-teal);
    --q-teal-900: var(--q-pp-teal);
    --q-teal-950: var(--q-pp-teal);
    --q-blue-alpha-main: var(--q-pp-accent);
    --q-blue-50: var(--q-pp-accent);
    --q-blue-100: var(--q-pp-accent);
    --q-blue-200: var(--q-pp-accent);
    --q-blue-300: var(--q-pp-accent);
    --q-blue-400: var(--q-pp-accent);
    --q-blue-500: var(--q-pp-accent);
    --q-blue-600: color-mix(in srgb, var(--q-pp-accent) 85%, var(--q-pp-crust));
    --q-blue-700: var(--q-pp-accent);
    --q-blue-800: var(--q-pp-accent);
    --q-blue-900: var(--q-pp-accent);
    --q-blue-950: var(--q-pp-accent);
    --q-purple-alpha-main: var(--q-pp-mauve);
    --q-purple-50: var(--q-pp-mauve);
    --q-purple-100: var(--q-pp-mauve);
    --q-purple-200: var(--q-pp-mauve);
    --q-purple-300: var(--q-pp-mauve);
    --q-purple-400: var(--q-pp-mauve);
    --q-purple-500: var(--q-pp-mauve);
    --q-purple-600: var(--q-pp-mauve);
    --q-purple-700: var(--q-pp-mauve);
    --q-purple-800: var(--q-pp-mauve);
    --q-purple-900: var(--q-pp-mauve);
    --q-purple-950: var(--q-pp-mauve);
    --q-pink-alpha-main: var(--q-pp-pink);
    --q-pink-50: var(--q-pp-pink);
    --q-pink-100: var(--q-pp-pink);
    --q-pink-200: var(--q-pp-pink);
    --q-pink-300: var(--q-pp-pink);
    --q-pink-400: var(--q-pp-pink);
    --q-pink-500: var(--q-pp-pink);
    --q-pink-600: var(--q-pp-pink);
    --q-pink-700: var(--q-pp-pink);
    --q-pink-800: var(--q-pp-pink);
    --q-pink-900: var(--q-pp-pink);
    --q-pink-950: var(--q-pp-pink);
    --q-yellow-alpha-main: var(--q-pp-yellow);

    --q-bg-canvas: var(--q-pp-mantle);
    --q-bg-surface: var(--q-pp-mantle);
    --q-bg-surface-raised: var(--q-pp-mantle);
    --q-sidebar-bg: var(--q-pp-mantle);
    --q-editor-bg: var(--q-pp-base);
    --q-editor-code-bg: var(--q-pp-crust);
    --q-accent-preset-1: var(--q-pp-accent);
    --q-accent-preset-2: var(--q-pp-mauve);
    --q-accent-preset-3: var(--q-pp-pink);
    --q-accent-preset-4: var(--q-pp-peach);
    --q-accent-preset-5: var(--q-pp-green);
    --q-accent-preset-6: var(--q-pp-teal);
    --q-editor-heading-1-color: var(--q-pp-red);
    --q-editor-heading-2-color: var(--q-pp-peach);
    --q-editor-heading-3-color: var(--q-pp-green);
    --q-editor-heading-4-color: var(--q-pp-teal);
    --q-editor-heading-5-color: var(--q-pp-blue);
    --q-editor-heading-6-color: var(--q-pp-mauve);
    --q-editor-heading-1-scale: 1.8;
    --q-editor-heading-2-scale: 1.6;
    --q-editor-heading-3-scale: 1.42;
    --q-editor-heading-4-scale: 1.27;
    --q-editor-heading-5-scale: 1.13;
    --q-editor-heading-6-scale: 1;
    --q-editor-strong-color: var(--q-pp-red);
    --q-editor-em-color: var(--q-pp-blue);

    /* Tinta: Text; el blanco es la hoja (Base). */
    --q-black-alpha-main: var(--q-pp-text);
    --q-white-alpha-main: var(--q-pp-base);
    --q-gray-alpha-main: var(--q-pp-subtext0);
    --q-gray-50: var(--q-pp-base);
    --q-gray-100: var(--q-pp-mantle);
    --q-gray-150: var(--q-pp-crust);
    --q-gray-200: var(--q-pp-surface0);
    --q-gray-250: var(--q-pp-surface1);
    --q-gray-300: var(--q-pp-surface2);
    --q-gray-350: var(--q-pp-overlay0);
    --q-gray-400: var(--q-pp-overlay1);
    --q-gray-450: var(--q-pp-overlay2);
    --q-gray-500: var(--q-pp-subtext0);
    --q-gray-550: var(--q-pp-subtext1);
    --q-gray-600: var(--q-pp-text);
    --q-gray-650: var(--q-pp-text);
    --q-gray-700: var(--q-pp-text);
    --q-gray-750: var(--q-pp-text);
    --q-gray-800: var(--q-pp-text);
    --q-gray-850: var(--q-pp-text);
    --q-gray-900: var(--q-pp-text);
    --q-gray-950: var(--q-pp-text);

}

[data-theme="paper-chalkboard"],
[data-theme="paper-moleskine"] {
    /* Un color por tono: toda la escala toma el mismo. */
    --q-red-alpha-main: var(--q-pp-red);
