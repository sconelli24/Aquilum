/* Temas de papel: sensacion de tomar notas en la vida real. Cada tema es una paleta de 26 colores (--q-pp-*)
   mas el color propio del calendario (--q-calendar-bg). El resto se deriva de la paleta como en Catppuccin:
   fondo de la nota = base (la hoja), paneles y marco de la ventana = mantle, codigo = crust. */

[data-theme="paper-notebook"] {
    color-scheme: light;
    --q-theme-name: 'Cuaderno';
    --q-pp-rosewater: #c4776a;
    --q-pp-flamingo: #c9736f;
    --q-pp-pink: #b5638f;
    --q-pp-mauve: #7a5aa6;
    --q-pp-red: #b3382f;
    --q-pp-maroon: #b8524b;
    --q-pp-peach: #c4682a;
    --q-pp-yellow: #b98a1d;
    --q-pp-green: #4f8a3c;
    --q-pp-teal: #2f8a82;
    --q-pp-sky: #3a8db0;
    --q-pp-sapphire: #3d7f9e;
    --q-pp-blue: #2c55a0;
    --q-pp-lavender: #5a6cc0;
    --q-pp-text: #27324d;
    --q-pp-subtext1: #3b4766;
    --q-pp-subtext0: #566079;
    --q-pp-overlay2: #6b7488;
    --q-pp-overlay1: #8b93a3;
    --q-pp-overlay0: #a3a9b6;
    --q-pp-surface2: #c9c2ac;
    --q-pp-surface1: #d9d2bc;
    --q-pp-surface0: #e6dfc8;
    --q-pp-base: #fbf6e6;
    --q-pp-mantle: #f1ead3;
    --q-pp-crust: #e6dec2;
    --q-pp-accent: #2c55a0;
    --q-calendar-bg: #fffdf4;
    --q-calendar-accent: var(--q-pp-red);
}

[data-theme="paper-legal"] {
    color-scheme: light;
    --q-theme-name: 'Libreta amarilla';
    --q-pp-rosewater: #c97a62;
    --q-pp-flamingo: #c9706a;
    --q-pp-pink: #b25d8a;
    --q-pp-mauve: #7b5a9e;
    --q-pp-red: #b0261f;
    --q-pp-maroon: #b5443c;
    --q-pp-peach: #c2641e;
    --q-pp-yellow: #a97d00;
    --q-pp-green: #4c8a2f;
    --q-pp-teal: #2a8579;
    --q-pp-sky: #3589a8;
    --q-pp-sapphire: #2f7d96;
    --q-pp-blue: #1f4e96;
    --q-pp-lavender: #4f60b3;
    --q-pp-text: #2a2a3a;
    --q-pp-subtext1: #3d3d4f;
    --q-pp-subtext0: #57576a;
    --q-pp-overlay2: #6d6d7e;
    --q-pp-overlay1: #8a8a97;
    --q-pp-overlay0: #a2a2ad;
    --q-pp-surface2: #d1c27a;
    --q-pp-surface1: #ddcf8c;
    --q-pp-surface0: #e9db9a;
    --q-pp-base: #f9ec9e;
    --q-pp-mantle: #f0df86;
    --q-pp-crust: #e4d26c;
    --q-pp-accent: #1f4e96;
    --q-calendar-bg: #fff9cf;
    --q-calendar-accent: var(--q-pp-red);
}

[data-theme="paper-kraft"] {
