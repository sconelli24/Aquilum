    --q-pp-pink: #a85c80;
    --q-pp-mauve: #75529a;
    --q-pp-red: #a8332a;
    --q-pp-maroon: #ad4a40;
    --q-pp-peach: #b85a1c;
    --q-pp-yellow: #a2761a;
    --q-pp-green: #5a7f34;
    --q-pp-teal: #357a6e;
    --q-pp-sky: #3a7f9a;
    --q-pp-sapphire: #34748c;
    --q-pp-blue: #2f5a8a;
    --q-pp-lavender: #5864a6;
    --q-pp-text: #3a281a;
    --q-pp-subtext1: #4d3826;
    --q-pp-subtext0: #664d38;
    --q-pp-overlay2: #7b6049;
    --q-pp-overlay1: #977c64;
