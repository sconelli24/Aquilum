# Dependencies
node_modules/

# Local / editor
.DS_Store
*.local
.env.local
.env.*.local
.idea/

# Cursor / agents
/.agents/
/.claude/

# All build outputs (dev + release Cargo caches, Vite dist, packaged releases)
/.artifacts/
/aquilum-app/.artifacts/
# Updater signing keys live outside the repo (~/.apus); never commit one
updater.key
*.key

# Safety net: old locations before .artifacts layout (must never return to git)
/aquilum-app/dist/
/aquilum-app/dist-ssr/
/aquilum-app/.build/
/aquilum-app/releases/
/aquilum-app/packaging/target/
/aquilum-app/target/
/aquilum-app/core/target/
/aquilum-app/core/Cargo.lock
/aquilum-app/native/vendor/winit-android/Cargo.lock

coverage/
*.tsbuildinfo

# Signing keys must never enter the repo (Tauri updater keypair, code-signing certs)
*.key
*.key.pub
*.pfx
*.p12
.tauri/
.env

# Obsidian plugin build, kept locally as reference material
/dataview/

# Aquilum note history: local, not tracked by git
.aquilum/

# Working copy of the public releases repository
/release-repo-update/

# App trash inside the vault (Aquilum service folder)
.trash/

__pycache__/
